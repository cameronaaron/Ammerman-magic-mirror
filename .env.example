# Copy to .env to override defaults. Every Settings field maps to MIRROR_<NAME>.
# MIRROR_SOURCE=live
# MIRROR_MIN_MAGNITUDE=2.0
# MIRROR_GENOME_PATH=/path/to/your_23andme.txt
# MIRROR_GENOME_FROM_USB=true
# MIRROR_GENOME_INBOX=dna                  # local drop folder for a 23andMe file
# MIRROR_DEVICE_ID=0
# MIRROR_MIRROR=true
# MIRROR_CACHE_TTL_DAYS=30
# MIRROR_RESOLVE_IIDS=true                 # translate 23andMe "i" ids to RSIDs
# MIRROR_IID_MAP_PATH=resources/iid_to_rsid.tsv
# --- web upload/accounts server (magic-mirror serve) ---
# MIRROR_WEB_DATA_DIR=web_data
# MIRROR_WEB_HOST=127.0.0.1
# MIRROR_WEB_PORT=8000
